PORT=
MONGO_URI=
NODE_ENV=
JWT_EXPIRE=
JWT_TOKEN_SECRET=

# Dars video/materiallarini imzolash uchun (JWT secretdan alohida) — GET /media/lessons/:file
MEDIA_SECRET=

# Vergul bilan ajratilgan, /media/lessons so'roviga Referer/Origin orqali ruxsat etilgan
# manbalar (faqat BERILGAN bo'lsa tekshiriladi — yo'q bo'lsa rad etilmaydi). Bo'sh qoldirilsa
# FRONTEND_URL ishlatiladi
MEDIA_ALLOWED_ORIGINS=

# ffmpeg binary PATH'da bo'lsa shart emas. PATH'da yo'q bo'lsa to'liq yo'lni ko'rsating
# (masalan /usr/bin/ffmpeg) — dars videolarini HLS+AES-128'ga o'tkazish uchun ishlatiladi
# (src/utils/hlsConverter.js). Serverda tekshirish: ffmpeg -version
FFMPEG_PATH=

PAGE_LIMIT=
TELEGRAM_BOT_TOKEN=

# Premium tarif narxi (tiyinda)
PREMIUM_PRICE=

# Multicard to'lov shlyuzi
MULTICARD_APP_ID=
MULTICARD_SECRET=
MULTICARD_STORE_ID=
MULTICARD_BASE_URL=
MULTICARD_CALLBACK_URL=
