PORT=
MONGO_URI=
NODE_ENV=

# Brauzerdan API/Socket.IO'ga murojaat qila oladigan saytlar (CORS), vergul bilan.
# Production'da MAJBURIY — berilmasa server ishga tushmaydi. Masalan:
# CLIENT_URL=https://edu-platform.uz,https://www.edu-platform.uz
CLIENT_URL=

# Reverse proxy (nginx) sozlamasi — rate limiter va faollik jurnali haqiqiy mijoz IP'sini
# ko'rishi uchun. Bo'sh = 'loopback' (nginx shu serverda). Oldida Cloudflare ham bo'lsa — 2,
# proksi boshqa mashinada bo'lsa — uning IP'si (masalan 10.0.0.5)
TRUST_PROXY=

# Ixtiyoriy. Frontend (Next.js) SSR so'rovlari tokensiz va bitta server IP'sidan keladi —
# `X-Internal-Key: <shu qiymat>` sarlavhasi bilan kelsa umumiy anonim limit (15 daqiqada 300)
# qo'llanmaydi. Faqat server-server: frontend'da NEXT_PUBLIC_ bo'lmagan env'da saqlang.
# Uzun tasodifiy qiymat (masalan: openssl rand -hex 32). Bo'sh — imtiyoz o'chiq.
SSR_INTERNAL_KEY=

JWT_EXPIRE=
JWT_TOKEN_SECRET=

# Dars video/materiallarini imzolash uchun (JWT secretdan alohida) — GET /media/lessons/:file
MEDIA_SECRET=

# Vergul bilan ajratilgan, /media/lessons so'roviga Referer/Origin orqali ruxsat etilgan
# manbalar (faqat BERILGAN bo'lsa tekshiriladi — yo'q bo'lsa rad etilmaydi). Bo'sh qoldirilsa
# FRONTEND_URL ishlatiladi
MEDIA_ALLOWED_ORIGINS=

# ffmpeg binary PATH'da bo'lsa shart emas. PATH'da yo'q bo'lsa to'liq yo'lni ko'rsating
# (masalan /usr/bin/ffmpeg) — dars videolarini HLS+AES-128'ga o'tkazish uchun ishlatiladi
# (src/utils/hlsConverter.js). Serverda tekshirish: ffmpeg -version
FFMPEG_PATH=

PAGE_LIMIT=
TELEGRAM_BOT_TOKEN=

# Premium tarif narxi (tiyinda)
PREMIUM_PRICE=

# Multicard to'lov shlyuzi
MULTICARD_APP_ID=
MULTICARD_SECRET=
MULTICARD_STORE_ID=
MULTICARD_BASE_URL=
MULTICARD_CALLBACK_URL=

# Google Gemini (AI dars generatsiyasi — POST /board-lessons/generate). Kalit:
# https://aistudio.google.com → "Get API key". Model — AI Studio'da bepul tarifda mavjud
# joriy "Flash" modeli nomi (masalan gemini-...-flash). Bo'sh bo'lsa endpoint 503 qaytaradi.
GEMINI_API_KEY=
GEMINI_MODEL=
# Ixtiyoriy. Asosiy model band (503 "high demand") yoki javob bermasa — darhol shu modelga
# o'tiladi (masalan gemini-3.1-flash-lite). GEMINI_MODEL'dan boshqa model. Bo'sh — zaxira yo'q.
GEMINI_FALLBACK_MODEL=
# Ixtiyoriy. Server Gemini qo'llab-quvvatlamaydigan mamlakatda bo'lsa (masalan Rossiya —
# "User location is not supported"), qo'llab-quvvatlanadigan mamlakatdagi reverse-proxy
# manzili, masalan https://gemini-proxy.example.uz (oxirida / siz). Bo'sh — to'g'ridan-to'g'ri.
GEMINI_BASE_URL=
