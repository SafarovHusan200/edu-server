        {
          "name": "Upload Material",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{teacherToken}}", "type": "string" }] },
            "url": "{{baseUrl}}/lessons/{{lessonId}}/material",
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "material", "type": "file", "src": [] }]
            }
          }
        },
        {
          "name": "Complete Lesson (student, +diamonds)",
          "request": { "method": "POST", "url": "{{baseUrl}}/lessons/{{lessonId}}/complete" }
        }
      ]
    },
    {
      "name": "Enrollment",
      "item": [
        {
          "name": "Enroll to Course",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/enrollment",
            "body": { "mode": "raw", "raw": "{\n  \"courseId\": \"{{courseId}}\"\n}" }
          }
        },
        {
          "name": "My Enrollments",
          "request": { "method": "GET", "url": "{{baseUrl}}/enrollment/my?page=1&limit=10" }
        },
        {
          "name": "Get Enrollment By Id",
          "request": { "method": "GET", "url": "{{baseUrl}}/enrollment/{{enrollmentId}}" }
        }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        {
          "name": "Update Review",
          "request": {
            "method": "PATCH",
