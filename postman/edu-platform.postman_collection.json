            "body": {
              "mode": "raw",
              "raw": "{\n  \"purpose\": \"course\",\n  \"courseId\": \"{{courseId}}\",\n  \"promoCode\": \"{{promoCode}}\",\n  \"returnUrl\": \"https://example.com/return\"\n}"
