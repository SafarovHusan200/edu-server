        }
      ]
    },
    {
      "name": "Quizzes",
      "item": [
        {
          "name": "List Quizzes",
          "request": { "method": "GET", "auth": { "type": "noauth" }, "url": "{{baseUrl}}/quizzes?page=1&limit=10" }
        },
        {
          "name": "Get Quiz By Id (student)",
          "request": { "method": "GET", "auth": { "type": "noauth" }, "url": "{{baseUrl}}/quizzes/{{quizId}}" }
        },
        {
          "name": "Get Quiz With Answers (teacher)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{teacherToken}}", "type": "string" }] },
            "url": "{{baseUrl}}/quizzes/{{quizId}}/answers"
          }
        },
        {
          "name": "Create Quiz",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{teacherToken}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/quizzes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Matematika testi\",\n  \"targetType\": \"standalone\",\n  \"passingScore\": 60,\n  \"maxAttempts\": 3\n}"
            }
          }
        },
        {
          "name": "Update Quiz",
          "request": {
            "method": "PATCH",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{teacherToken}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/quizzes/{{quizId}}",
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Yangilangan test nomi\"\n}" }
          }
        },
        {
          "name": "Delete Quiz",
          "request": {
            "method": "DELETE",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{teacherToken}}", "type": "string" }] },
            "url": "{{baseUrl}}/quizzes/{{quizId}}"
          }
        },
