          "name": "Get Lesson By Id",
          "request": { "method": "GET", "url": "{{baseUrl}}/lessons/{{lessonId}}" }
        },
        {
          "name": "Update Lesson",
          "request": {
            "method": "PATCH",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{teacherToken}}", "type": "string" }] },
