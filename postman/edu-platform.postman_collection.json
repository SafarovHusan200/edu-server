{
  "info": {
    "name": "Edu Platform API",
    "description": "edu-platform.uz server-api uchun to'liq Postman kolleksiyasi",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "token", "value": "" },
    { "key": "teacherToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "courseId", "value": "" },
    { "key": "lessonId", "value": "" },
    { "key": "enrollmentId", "value": "" },
    { "key": "reviewId", "value": "" },
    { "key": "notificationId", "value": "" },
    { "key": "quizId", "value": "" },
    { "key": "questionId", "value": "" },
    { "key": "attemptId", "value": "" },
    { "key": "invoiceId", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "rewardId", "value": "" },
    { "key": "redemptionId", "value": "" },
    { "key": "certificateId", "value": "" },
    { "key": "certificateNumber", "value": "" },
    { "key": "promoCodeId", "value": "" },
    { "key": "promoCode", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ali Valiyev\",\n  \"phone\": \"998901234567\",\n  \"password\": \"password123\",\n  \"role\": \"student\",\n  \"grade\": { \"number\": 5, \"letter\": \"A\" }\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"998901234567\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Telegram OTP Verify",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/telegram",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"telegramId\": \"123456789\",\n  \"code\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Get Me",
          "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/logout" }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Update Me",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/users/me",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Yangi Ism\"\n}" }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/users/me/password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"password123\",\n  \"newPassword\": \"newpassword123\"\n}"
            }
          }
        },
        {
          "name": "Upload Avatar",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users/me/avatar",
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "avatar", "type": "file", "src": [] }]
            }
          }
        },
        {
          "name": "Leaderboard",
          "request": { "method": "GET", "url": "{{baseUrl}}/users/leaderboard?page=1&limit=10" }
        },
        {
          "name": "List Users (admin)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "url": "{{baseUrl}}/users?page=1&limit=10"
          }
        },
        {
          "name": "Get User By Id (admin)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        },
        {
          "name": "Block/Unblock User (admin)",
          "request": {
            "method": "PATCH",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/users/{{userId}}/block",
            "body": { "mode": "raw", "raw": "{\n  \"isBlocked\": true\n}" }
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "List Categories",
          "request": { "method": "GET", "auth": { "type": "noauth" }, "url": "{{baseUrl}}/categories" }
        },
        {
          "name": "Get Category By Id",
          "request": { "method": "GET", "auth": { "type": "noauth" }, "url": "{{baseUrl}}/categories/{{categoryId}}" }
        },
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{teacherToken}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/categories",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dasturlash\",\n  \"description\": \"Dasturlash bo'yicha kurslar\"\n}"
            }
          }
        },
        {
          "name": "Update Category",
          "request": {
            "method": "PATCH",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{teacherToken}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/categories/{{categoryId}}",
            "body": { "mode": "raw", "raw": "{\n  \"description\": \"Yangilangan tavsif\"\n}" }
          }
        },
        {
          "name": "Delete Category",
          "request": {
            "method": "DELETE",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "url": "{{baseUrl}}/categories/{{categoryId}}"
          }
        }
      ]
    },
    {
      "name": "Courses",
      "item": [
        {
          "name": "List Courses",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": "{{baseUrl}}/courses?page=1&limit=10&search=js"
          }
        },
        {
          "name": "Get Course By Id",
          "request": { "method": "GET", "auth": { "type": "noauth" }, "url": "{{baseUrl}}/courses/{{courseId}}" }
        },
        {
          "name": "Create Course",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{teacherToken}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/courses",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"JavaScript asoslari\",\n  \"description\": \"Noldan JavaScript o'rganish\",\n  \"category\": \"{{categoryId}}\",\n  \"price\": 0\n}"
            }
          }
        },
        {
          "name": "Update Course (publish)",
          "request": {
            "method": "PATCH",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{teacherToken}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/courses/{{courseId}}",
            "body": { "mode": "raw", "raw": "{\n  \"isPublished\": true\n}" }
          }
        },
        {
          "name": "Delete Course",
          "request": {
            "method": "DELETE",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{teacherToken}}", "type": "string" }] },
            "url": "{{baseUrl}}/courses/{{courseId}}"
          }
        },
        {
          "name": "Upload Thumbnail",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{teacherToken}}", "type": "string" }] },
            "url": "{{baseUrl}}/courses/{{courseId}}/thumbnail",
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "thumbnail", "type": "file", "src": [] }]
            }
          }
        },
        {
          "name": "Get Course Stats (teacher)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{teacherToken}}", "type": "string" }] },
            "url": "{{baseUrl}}/courses/{{courseId}}/stats"
          }
        },
        {
          "name": "List Lessons of Course",
          "request": { "method": "GET", "auth": { "type": "noauth" }, "url": "{{baseUrl}}/courses/{{courseId}}/lessons" }
        },
        {
          "name": "Create Lesson in Course",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{teacherToken}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/courses/{{courseId}}/lessons",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"1-dars: Kirish\",\n  \"description\": \"Kursga kirish\",\n  \"content\": \"Dars matni...\",\n  \"order\": 1\n}"
            }
          }
        },
        {
          "name": "List Reviews of Course",
          "request": { "method": "GET", "auth": { "type": "noauth" }, "url": "{{baseUrl}}/courses/{{courseId}}/reviews" }
        },
        {
          "name": "Create Review for Course",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/courses/{{courseId}}/reviews",
            "body": { "mode": "raw", "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Juda foydali kurs!\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Lessons",
      "item": [
